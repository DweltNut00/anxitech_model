# Aplicacion
APP_HOST=0.0.0.0
PORT=8000
APP_RELOAD=false
APP_LOG_LEVEL=info

# Si despliegas detras de un proxy con prefijo, por ejemplo /backend
API_ROOT_PATH=

# CORS
# Usa * solo si no necesitas cookies o credenciales.
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,https://anxitechfrontend.netlify.app/,https://railway.com/project/f9f67f8e-87ee-41bf-9a3a-09a6751751ae
CORS_ALLOW_CREDENTIALS=true

# Base de datos MySQL
# Opcion 1: variables separadas
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=anxitech
DB_CONNECTION_TIMEOUT=30

# Opcion 2: URL completa del proveedor (Railway, Render, Aiven, etc.)
DATABASE_URL=

# SSL opcional para bases remotas
# Si tu proveedor exige SSL, normalmente usa DB_SSL_DISABLED=false
DB_SSL_DISABLED=
DB_SSL_CA=
DB_SSL_CERT=
DB_SSL_KEY=
DB_SSL_VERIFY_CERT=
DB_SSL_VERIFY_IDENTITY=

# Modelo ML
MODEL_PATH=modelos/modelo_ansiedad.pkl
